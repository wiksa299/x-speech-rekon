function(xsl_embed_fluid_recipes target)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/fluid_recipes.hpp")
    set(content "#pragma once\nnamespace xsl {\n")
    string(REPEAT "[0-9a-f][0-9a-f]" 16 row)
    foreach(model IN ITEMS mini pro pro_crispasr)
        set(recipe "${PROJECT_SOURCE_DIR}/assets/fluid/${model}.recipe")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${recipe}")
        file(READ "${recipe}" bytes HEX)
        string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
        string(APPEND content "inline constexpr unsigned char fluid_${model}_recipe[] = {\n${bytes}\n};\n")
    endforeach()
    string(APPEND content "}\n")
    file(GENERATE OUTPUT "${output}" CONTENT "${content}")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
endfunction()
