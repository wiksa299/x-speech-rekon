# Keep Listen's recognizers, the upstream VAD API and Parakeet's linked diarizer.
function(xsl_prune_transcribe source_dir)
    set(families parakeet moonshine_streaming silero_vad sortformer)
    set(source_list "${source_dir}/src/CMakeLists.txt")
    set(registry_file "${source_dir}/src/transcribe-arch.cpp")
    set(loader_file "${source_dir}/src/transcribe.cpp")
    file(READ "${source_list}" original_sources)
    file(READ "${registry_file}" original_registry)
    set(sources "${original_sources}")
    set(registry "${original_registry}")
    string(REGEX MATCHALL "[ \t]arch/[a-z0-9_]+/" source_families "${sources}")
    string(REGEX REPLACE "[ \t]arch/([a-z0-9_]+)/" "\\1" source_families "${source_families}")
    list(REMOVE_DUPLICATES source_families)
    file(READ "${loader_file}" original_loader)
    set(loader "${original_loader}")
    foreach(family IN LISTS source_families)
        if(family IN_LIST families)
            continue()
        endif()
        string(REGEX REPLACE "[ \t]+arch/${family}/[^\r\n]+\r?\n" "" sources "${sources}")
        string(REGEX REPLACE "namespace ${family} [{][^}]+[}][\r\n]+" "" registry "${registry}")
        string(REGEX REPLACE "[ \t]+&${family}::arch," "" registry "${registry}")
        string(REGEX REPLACE "#include \"arch/${family}/[^\"\r\n]+\"\r?\n" "" loader "${loader}")
        string(REGEX REPLACE "transcribe::${family}::load_from_bin\\(path, params, out_model\\)"
            "TRANSCRIBE_ERR_UNSUPPORTED_ARCH" loader "${loader}")
        if(sources MATCHES "[ \t]arch/${family}/" OR registry MATCHES "&${family}::arch|namespace ${family} [{]"
            OR loader MATCHES "transcribe::${family}::|#include \"arch/${family}/")
            message(FATAL_ERROR "Could not remove the ${family} backend from transcribe.cpp")
        endif()
    endforeach()
    foreach(family IN LISTS families)
        if(NOT sources MATCHES "[ \t]arch/${family}/" OR NOT registry MATCHES "&${family}::arch")
            message(FATAL_ERROR "Missing the required ${family} backend in transcribe.cpp")
        endif()
    endforeach()
    string(REGEX REPLACE "[ \t]+third_party/miniz/miniz\\.c\r?\n" "" sources "${sources}")
    if(NOT sources STREQUAL original_sources)
        file(WRITE "${source_list}" "${sources}")
    endif()
    if(NOT registry STREQUAL original_registry)
        file(WRITE "${registry_file}" "${registry}")
    endif()
    if(NOT loader STREQUAL original_loader)
        file(WRITE "${loader_file}" "${loader}")
    endif()
endfunction()
