+constexpr float k_vocabulary_boost       = 2.0f;
+constexpr float k_initial_token_fraction = 0.30f;
+
+transcribe::PhraseBoost build_vocabulary_boost(const MoonshineStreamingModel & model,
+                                               const transcribe_run_params *   params) {
+    transcribe::PhraseBoost boost;
+    if (params == nullptr || params->n_vocabulary == 0) {
+        return boost;
+    }
+    const float score = transcribe::listen_vocabulary_boost(params, k_vocabulary_boost);
+    if (score == 0.0f) {
+        return boost;
+    }
+
+    std::vector<std::string> spellings;
+    for (const std::string & raw : transcribe::prompting::terms(params)) {
+        std::string term = transcribe::prompting::strip(raw);
+        if (term.empty()) {
+            continue;
+        }
+        spellings.push_back(term);
+        char & initial = term.front();
+        if (initial >= 'a' && initial <= 'z') {
+            initial = static_cast<char>(initial - 'a' + 'A');
+            spellings.push_back(term);
+        } else if (initial >= 'A' && initial <= 'Z') {
+            initial = static_cast<char>(initial - 'A' + 'a');
+            spellings.push_back(term);
+        }
+    }
+
+    std::vector<std::vector<int32_t>> phrases;
+    if (model.tok.encode_sentencepiece_bpe_batch(spellings, phrases, true) != TRANSCRIBE_OK) {
+        return boost;
+    }
+    const auto invalid_id = [&](int32_t id) {
+        return model.tok.is_unknown(id) || model.tok.is_control(id) || id == model.hparams.eos_token_id;
+    };
+    phrases.erase(std::remove_if(
+                      phrases.begin(), phrases.end(),
+                      [&](const auto & ids) { return ids.empty() || std::any_of(ids.begin(), ids.end(), invalid_id); }),
+                  phrases.end());
+    boost.build(phrases, score, score * k_initial_token_fraction);
+    return boost;
+}
