# Remove the upstream model families and their dispatch entries together.
function(xsr_prune_transcribe source_dir)
    set(source_list "${source_dir}/src/CMakeLists.txt")
    set(registry_file "${source_dir}/src/transcribe-arch.cpp")
    file(READ "${source_list}" original_sources)
    file(READ "${registry_file}" original_registry)
    set(sources "${original_sources}")
    set(registry "${original_registry}")
    foreach(family IN ITEMS qwen3_asr canary_qwen)
        string(REGEX REPLACE "[ \t]+arch/${family}/[^\r\n]+\r?\n" "" sources "${sources}")
        string(REGEX REPLACE "namespace ${family} [{][^}]+[}][\r\n]+" "" registry "${registry}")
        string(REGEX REPLACE "[ \t]+&${family}::arch," "" registry "${registry}")
        if(sources MATCHES "arch/${family}/" OR registry MATCHES "${family}::arch|namespace ${family}")
            message(FATAL_ERROR "Could not remove the ${family} backend from transcribe.cpp")
        endif()
    endforeach()
    if(NOT sources STREQUAL original_sources)
        file(WRITE "${source_list}" "${sources}")
    endif()
    if(NOT registry STREQUAL original_registry)
        file(WRITE "${registry_file}" "${registry}")
    endif()
endfunction()
