new file mode 100644
index 00000000..464cc974
--- /dev/null
+++ b/src/transcribe-listen-decode.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "transcribe/listen.h"
+
+#include <cmath>
+
+namespace transcribe {
+
+inline const transcribe_listen_decode_params * listen_decode_params(const transcribe_run_params * params) {
+    if (!params || !params->family || params->family->kind != TRANSCRIBE_EXT_KIND_LISTEN_DECODE ||
+        params->family->size < sizeof(transcribe_listen_decode_params)) {
+        return nullptr;
+    }
+    return reinterpret_cast<const transcribe_listen_decode_params *>(params->family);
+}
+
+inline float listen_vocabulary_boost(const transcribe_run_params * params, float default_boost) {
+    const auto * options = listen_decode_params(params);
+    return options && options->vocabulary_boost >= 0.0f ? options->vocabulary_boost : default_boost;
+}
+
+inline transcribe_status validate_listen_decode(const transcribe_run_params * params,
+                                               bool                          supports_beam,
+                                               bool                          supports_vocabulary) {
+    if (!params || !params->family) {
+        return TRANSCRIBE_OK;
+    }
+    const auto status =
+        transcribe_ext_check(params->family, TRANSCRIBE_EXT_KIND_LISTEN_DECODE, sizeof(transcribe_listen_decode_params));
+    if (status != TRANSCRIBE_OK) {
+        return status;
+    }
+    const auto * options = listen_decode_params(params);
+    const float  boost   = options->vocabulary_boost;
+    if (options->beam_width < 1 || options->beam_width > 4 || (options->beam_width > 1 && !supports_beam) ||
+        !std::isfinite(boost) || (boost != -1.0f && (boost < 0.0f || boost > 4.0f)) ||
+        (boost > 0.0f && !supports_vocabulary)) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    return TRANSCRIBE_OK;
+}
+
+}  // namespace transcribe
