+// Experimental offline TDT beam for the cockpit benchmark.
+namespace {
+
+struct BeamPredictor {
+    int                              token = -1;
+    std::shared_ptr<const LstmState> before;
+    std::shared_ptr<LstmState>       after;
+};
+
+struct BeamPath {
+    std::shared_ptr<BeamPredictor> predictor;
+    std::vector<TdtToken>          tokens;
+    float                          score            = 0.0f;
+    int                            boost_state      = transcribe::PhraseBoost::root;
+    int                            symbols_on_frame = 0;
+};
+
+bool same_prefix(const BeamPath & a, const BeamPath & b) {
+    return a.symbols_on_frame == b.symbols_on_frame && a.tokens.size() == b.tokens.size() &&
+           std::equal(a.tokens.begin(), a.tokens.end(), b.tokens.begin(),
+                      [](const auto & x, const auto & y) { return x.id == y.id; });
+}
+
+template <typename Score> void keep_path(std::vector<BeamPath> & paths, BeamPath next, size_t width, Score score) {
+    if (!std::isfinite(next.score)) {
+        return;
+    }
+    auto it = std::find_if(paths.begin(), paths.end(), [&](const auto & p) { return same_prefix(p, next); });
+    if (it != paths.end()) {
+        if (score(*it) < score(next)) {
+            *it = std::move(next);
+        }
+        return;
+    }
+    if (paths.size() == width) {
+        it = std::min_element(paths.begin(), paths.end(),
+                              [&](const auto & x, const auto & y) { return score(x) < score(y); });
+        if (score(*it) < score(next)) {
+            *it = std::move(next);
+        }
+    } else {
+        paths.push_back(std::move(next));
+    }
+}
+
+float log_normalizer(const float * logits, int count) {
+    float  max_logit = *std::max_element(logits, logits + count);
+    double sum       = 0.0;
+    for (int i = 0; i < count; ++i) {
+        sum += std::exp(logits[i] - max_logit);
+    }
+    return max_logit + static_cast<float>(std::log(sum));
+}
+
+}  // namespace
+
+transcribe_status decode_tdt_beam(transcribe_session &                 session,
+                                  const HostDecoderWeights &           w,
+                                  const float *                        enc_out,
+                                  int                                  frames,
+                                  int                                  d_enc,
+                                  int                                  n_threads,
+                                  int                                  beam_width,
+                                  std::vector<TdtToken> &              out_tokens,
+                                  std::vector<std::vector<TdtToken>> & out_alternatives,
+                                  const transcribe::PhraseBoost *      boost) {
+    if (!enc_out || frames <= 0 || d_enc != w.joint.d_enc || beam_width < 2 || beam_width > 4 ||
+        w.tdt_durations.empty() || w.tdt_global_symbol_budget) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    if (std::any_of(w.tdt_durations.begin(), w.tdt_durations.end(), [](int d) { return d < 0; })) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    if (boost && boost->empty()) {
+        boost = nullptr;
+    }
+
+    if (session.poll_abort()) {
+        return TRANSCRIBE_ERR_ABORTED;
+    }
+
+    const int n_layers       = static_cast<int>(w.predictor.lstm.size());
+    const int hidden         = w.predictor.pred_hidden;
+    const int token_count    = w.predictor.pred_vocab;
+    const int duration_count = static_cast<int>(w.tdt_durations.size());
+    const int blank          = w.blank_id;
+    const int max_symbols    = w.tdt_max_symbols > 0 ? w.tdt_max_symbols : 10;
+
+    PredGraph  pg;
+    JointGraph jg;
+    build_pred_graph(pg, w.predictor, resolve_decode_threads(n_threads));
+    if (pg.ready) {
+        build_joint_graph(jg, w.joint, pg.backend);
+    }
+    if (!pg.ready || !jg.ready) {
+        return TRANSCRIBE_ERR_BACKEND;
+    }
+    std::vector<float> enc_proj;
+    if (!precompute_enc_proj_ggml(w.joint, pg.backend, enc_out, frames, d_enc, enc_proj)) {
+        return TRANSCRIBE_ERR_BACKEND;
+    }
+
+    auto initial = std::make_shared<LstmState>();
+    initial->reset(n_layers, hidden);
+    std::vector<std::vector<BeamPath>> pending(static_cast<size_t>(frames));
+    std::vector<BeamPath>              completed;
+    BeamPath                           root;
+    root.predictor         = std::make_shared<BeamPredictor>();
+    root.predictor->before = std::move(initial);
+    pending[0].push_back(std::move(root));
+
+    auto raw_score = [](const BeamPath & path) {
+        return path.score;
+    };
+    auto normalized = [](const BeamPath & path) {
+        return path.score / (path.tokens.size() + 1);
+    };
+    auto place = [&](int frame, BeamPath path) {
+        if (frame < frames) {
+            keep_path(pending[frame], std::move(path), beam_width, raw_score);
+        } else {
+            if (boost) {
+                path.score -= boost->unfinished_bonus(path.boost_state);
+            }
+            path.symbols_on_frame = 0;
+            keep_path(completed, std::move(path), beam_width, normalized);
+        }
+    };
+    std::vector<float> scratch_x, logits, boosted, scratch_probs;
+    std::vector<int>   tokens(static_cast<size_t>(token_count - 1));
+    for (int i = 0, index = 0; i < token_count; ++i) {
+        if (i != blank) {
+            tokens[index++] = i;
+        }
+    }
+    std::vector<int> durations(static_cast<size_t>(duration_count));
+    for (int i = 0; i < duration_count; ++i) {
+        durations[i] = i;
+    }
+    const int duration_width = std::min(beam_width, duration_count);
+    const int token_width    = std::min(beam_width, token_count - 1);
+
+    constexpr float score_window = 8.0f;
+    for (int frame = 0; frame < frames; ++frame) {
+        if (session.poll_abort()) {
+            return TRANSCRIBE_ERR_ABORTED;
+        }
+        float best_frame_score = -std::numeric_limits<float>::infinity();
+        while (!pending[frame].empty()) {
+            auto paths = std::move(pending[frame]);
+            pending[frame].clear();
+            for (const auto & path : paths) {
+                best_frame_score = std::max(best_frame_score, path.score);
+                if (path.score < best_frame_score - score_window) {
+                    continue;
+                }
+                auto & pred = *path.predictor;
+                if (!pred.after) {
+                    pred.after = std::make_shared<LstmState>();
+                    pred.after->reset(n_layers, hidden);
+                    if (!predictor_step_ggml(w.predictor, pg, pred.token, *pred.before, *pred.after, scratch_x)) {
+                        return TRANSCRIBE_ERR_BACKEND;
+                    }
+                }
+                if (!joint_step(w.joint, jg, enc_proj.data() + static_cast<size_t>(frame) * w.joint.joint_h,
+                                pred.after->h.back().data(), logits)) {
+                    return TRANSCRIBE_ERR_BACKEND;
+                }
+                const float * raw      = logits.data();
+                const float * dur      = raw + token_count;
+                const float   norm     = log_normalizer(raw, token_count);
+                const float   dur_norm = log_normalizer(dur, duration_count);
+                if (!std::isfinite(norm) || !std::isfinite(dur_norm)) {
+                    return TRANSCRIBE_ERR_BACKEND;
+                }
+                auto duration_order = [&](int a, int b) {
+                    return dur[a] == dur[b] ? a < b : dur[a] > dur[b];
+                };
+                std::partial_sort(durations.begin(), durations.begin() + duration_width, durations.end(),
+                                  duration_order);
+
+                bool sent_blank = false;
+                for (int i = 0; i < duration_width; ++i) {
+                    int d = durations[i];
+                    if (w.tdt_durations[d] <= 0) {
+                        continue;
+                    }
+                    BeamPath next = path;
+                    next.score += raw[blank] - norm + dur[d] - dur_norm;
+                    next.symbols_on_frame = 0;
+                    place(frame + w.tdt_durations[d], std::move(next));
+                    sent_blank = true;
+                }
+                if (!sent_blank) {
+                    int best = -1;
+                    for (int i = 0; i < duration_count; ++i) {
+                        if (w.tdt_durations[i] > 0 && (best < 0 || duration_order(i, best))) {
+                            best = i;
+                        }
+                    }
+                    BeamPath next = path;
+                    next.score += raw[blank] - norm + (best < 0 ? 0.0f : dur[best] - dur_norm);
+                    next.symbols_on_frame = 0;
+                    place(frame + (best < 0 ? 1 : w.tdt_durations[best]), std::move(next));
+                }
+
+                const float * ranked = raw;
+                if (boost) {
+                    boosted.assign(raw, raw + token_count);
+                    boost->apply(path.boost_state, boosted.data(), token_count, blank);
+                    ranked = boosted.data();
+                }
+                std::partial_sort(tokens.begin(), tokens.begin() + token_width, tokens.end(),
+                                  [&](int a, int b) { return ranked[a] == ranked[b] ? a < b : ranked[a] > ranked[b]; });
+                const float confidence = token_confidence(raw, token_count, scratch_probs);
+                for (int i = 0; i < token_width; ++i) {
+                    const int   token     = tokens[i];
+                    const float bonus     = boost ? boost->delta(path.boost_state, token) : 0.0f;
+                    auto        next_pred = std::make_shared<BeamPredictor>();
+                    next_pred->token      = token;
+                    next_pred->before     = pred.after;
+                    for (int j = 0; j < duration_width; ++j) {
+                        const int d    = durations[j];
+                        const int step = w.tdt_durations[d];
+                        BeamPath  next = path;
+                        next.predictor = next_pred;
+                        next.score += raw[token] - norm + bonus + dur[d] - dur_norm;
+                        TdtToken emitted;
+                        emitted.id              = token;
+                        emitted.p               = confidence;
+                        emitted.step_at_emit    = frame;
+                        emitted.duration_frames = step;
+                        next.tokens.push_back(emitted);
+                        if (boost) {
+                            next.boost_state = boost->next(next.boost_state, token);
+                        }
+                        next.symbols_on_frame = step == 0 ? next.symbols_on_frame + 1 : 0;
+                        int target            = frame + step;
+                        if (next.symbols_on_frame >= max_symbols) {
+                            ++target;
+                            next.symbols_on_frame = 0;
+                        }
+                        place(target, std::move(next));
+                    }
+                }
+            }
+        }
+    }
+    if (completed.empty()) {
+        return TRANSCRIBE_ERR_BACKEND;
+    }
+    std::stable_sort(completed.begin(), completed.end(),
+                     [&](const auto & a, const auto & b) { return normalized(a) > normalized(b); });
+    out_tokens = std::move(completed.front().tokens);
+    out_alternatives.clear();
+    for (size_t i = 1; i < completed.size(); ++i) {
+        out_alternatives.push_back(std::move(completed[i].tokens));
+    }
+    return TRANSCRIBE_OK;
+}
