set(XSR_MOONSHINE_SDK "" CACHE PATH "Extracted Moonshine Voice v0.1.6 native SDK")
if(NOT XSR_MOONSHINE_SDK)
    return()
endif()

set(moonshine_lib "${XSR_MOONSHINE_SDK}/lib")
set(moonshine_catalog "${PROJECT_SOURCE_DIR}/assets/moonshine-catalog.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${moonshine_catalog}")
file(READ "${moonshine_catalog}" XSR_MOONSHINE_CATALOG)
configure_file("${PROJECT_SOURCE_DIR}/cmake/moonshine_catalog.hpp.in" moonshine_catalog.hpp @ONLY)
target_include_directories(xsr-engine PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_definitions(xsr-engine PRIVATE XSR_MOONSHINE=1 XSR_MOONSHINE_VERSION="0.1.6")

if(WIN32 AND MSVC)
    # The official SDK uses the release dynamic CRT. Keep it behind a C DLL boundary.
    add_library(xsr-moonshine SHARED src/moonshine.cpp)
    set_target_properties(xsr-moonshine PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    target_compile_definitions(xsr-moonshine PRIVATE XSR_MOONSHINE_BRIDGE _ITERATOR_DEBUG_LEVEL=0)
    target_include_directories(xsr-moonshine PRIVATE "${XSR_MOONSHINE_SDK}/include")
    foreach(lib IN ITEMS moonshine ort-utils bin-tokenizer moonshine-utils onnxruntime)
        target_link_libraries(xsr-moonshine PRIVATE "${moonshine_lib}/${lib}.lib")
    endforeach()
    target_link_libraries(xsr-moonshine PRIVATE ole32 mmdevapi)
    target_link_libraries(xsr-engine PRIVATE xsr-moonshine)
    add_custom_command(TARGET xsr-moonshine POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${moonshine_lib}/onnxruntime.dll" "$<TARGET_FILE_DIR:xsr-moonshine>")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_sources(xsr-engine PRIVATE src/moonshine.cpp)
    target_include_directories(xsr-engine PRIVATE "${XSR_MOONSHINE_SDK}/include")
    target_link_libraries(xsr-engine PRIVATE "${moonshine_lib}/libmoonshine.so")
elseif(APPLE)
    find_library(moonshine_foundation Foundation REQUIRED)
    find_library(moonshine_core_foundation CoreFoundation REQUIRED)
    target_sources(xsr-engine PRIVATE src/moonshine.cpp)
    target_include_directories(xsr-engine PRIVATE "${XSR_MOONSHINE_SDK}/include")
    target_link_libraries(xsr-engine PRIVATE "${moonshine_lib}/libmoonshine.a"
        "${moonshine_foundation}" "${moonshine_core_foundation}")
else()
    message(FATAL_ERROR "XSR_MOONSHINE_SDK requires a Linux, macOS, or Windows MSVC SDK")
endif()
