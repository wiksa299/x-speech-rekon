# Verify the language files in an extracted plugin against the source distribution.
set(source "${CMAKE_CURRENT_LIST_DIR}/../assets/locales")
file(READ "${source}/catalog.json" registry)
string(JSON count LENGTH "${registry}")
math(EXPR last "${count} - 1")
set(files catalog.json)
foreach(index RANGE 0 ${last})
    string(JSON code MEMBER "${registry}" ${index})
    list(APPEND files "${code}.json")
endforeach()
foreach(file IN LISTS files)
    file(SHA256 "${source}/${file}" expected)
    file(SHA256 "${PLUGIN_DIR}/locales/${file}" actual)
    if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "Packaged language file differs from source: ${file}")
    endif()
endforeach()
